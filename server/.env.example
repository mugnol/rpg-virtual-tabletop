# Copy to .env for local development (gitignored).

# SQLite for zero-install dev. PostgreSQL in test CI and prod:
# DATABASE_URL="postgresql://user:password@host:5432/vtt"
DATABASE_URL="file:./dev.db"

# Server port (dev default 3001; Vite proxies /api here)
PORT=3001

# Session signing secret. REQUIRED in production — the server refuses to boot without it.
# Generate with: openssl rand -base64 32
JWT_SECRET="dev-only-insecure-secret-change-me"

# Set Secure flag on the session cookie (default: false unless explicitly set to "true" or "1").
# Keep unset or set to "false" when accessing over plain HTTP (e.g. testing with IP address).
# Set to "true" when serving behind HTTPS/TLS reverse proxy.
COOKIE_SECURE=false
