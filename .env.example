# RPG Virtual Tabletop - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# Application runtime environment ('development', 'test', or 'production')
NODE_ENV=development

# HTTP & WebSocket port
# In development, the backend listens on PORT (default 3001) while Vite runs on 5173.
# In production, the unified backend serves both the API and client static bundle on PORT.
PORT=3001

# Database connection URL
# SQLite (zero-install local development):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production / Docker Compose / staging):
# DATABASE_URL="postgresql://vtt:vttpassword@localhost:5432/vtt?schema=public"

# Session signing secret for JWT tokens (HS256)
# REQUIRED in production — application will fail to start if not provided.
# Generate a strong key with: openssl rand -base64 32
JWT_SECRET="dev-only-insecure-secret-change-me"

# Cookie Secure flag configuration
# Default: false unless explicitly set to "true" or "1".
# Keep unset or set to "false" when accessing over plain HTTP (e.g. testing with IP address).
# Set to "true" when serving behind HTTPS/TLS reverse proxy.
COOKIE_SECURE=false
